# Copy this file to terraform.tfvars and replace every placeholder.
aws_region = "us-east-1"
task_name  = "cmr-semantic-search-export-test"

# No Elasticsearch credentials or IAM signing are configured. Network routes
# and security groups must allow this task to connect directly to the cluster.
elasticsearch_url          = "http://10.0.0.123:9200"
elasticsearch_verify_certs = true
collection_alias           = "collection_search_alias"
# Confirm this alias in each environment.
variable_alias = "1_variables"

# The task generates a unique versioned object name beneath this prefix.
s3_bucket_name = "REPLACE_WITH_EXISTING_BUCKET"
s3_prefix      = "semantic-collections"

subnet_ids = [
  "subnet-REPLACE_ME_1",
  "subnet-REPLACE_ME_2",
]
security_group_ids = [
  "sg-REPLACE_ME",
]

max_collections     = 100000
page_size            = 100
variable_batch_size = 500

ecr_repository_name = "cmr-semantic-search-export"
# Use a commit SHA or another immutable value and push it before full apply.
image_tag = "test-20260823"

task_cpu              = 1024
task_memory_mb        = 2048
ephemeral_storage_gib = 21
cpu_architecture      = "X86_64"

container_insights_enabled = true
log_retention_days          = 14
permissions_boundary_arn    = null

tags = {
  Environment = "test"
  Application = "cmr-semantic-search-export"
}
