# Copy this file to terraform.tfvars and replace every placeholder.
aws_region = "us-east-1"

function_name           = "cmr-semantic-search-export-test"
deployment_package_path = "../semantic-search-export-lambda.zip"

# No username, password, API key, or IAM signing is configured. Security groups
# and routing must allow this Lambda to connect directly to the EC2 cluster.
elasticsearch_url          = "http://10.0.0.123:9200"
elasticsearch_verify_certs = true
collection_alias           = "collection_search_alias"
variable_alias             = "variables"

# Create this bucket before terraform apply. The output key must remain beneath
# s3_prefix because the execution role is restricted to that prefix.
s3_bucket_name = "REPLACE_WITH_EXISTING_BUCKET"
s3_prefix      = "exports"
default_s3_key = "exports/collections-test.jsonl"

# Use private subnets that can route to Elasticsearch. They also need S3 access,
# either through an S3 gateway endpoint or through NAT.
subnet_ids = [
  "subnet-REPLACE_ME_1",
  "subnet-REPLACE_ME_2",
]
security_group_ids = [
  "sg-REPLACE_ME",
]

max_collections     = 1000
page_size            = 100
variable_batch_size = 500

runtime                  = "python3.12"
architecture             = "x86_64"
memory_size_mb           = 1024
timeout_seconds          = 900
ephemeral_storage_mb     = 1024
reserved_concurrency     = 1
log_retention_days       = 14
permissions_boundary_arn = null

tags = {
  Environment = "test"
  Application = "cmr-semantic-search-export"
}

